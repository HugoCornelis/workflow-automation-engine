sub test_report_error_diffs
{
    my $arguments = shift || [ '' ];

    my $mode = $arguments->[0] || 'executed_command_with_module';

    $mode = 'commands_modules';

    my $filter = '';

    my $regex = '050_executed_command';

    # commands_only

    if ($mode eq 'commands_only')
    {
	# shorten the reported path

	$filter = "| cut -d: -f3-";
    }

    # modules and commands

    elsif ($mode eq 'commands_modules')
    {
	# select the module name and executed command

	$regex = "-E '010_module_name|050_executed_command'";

	# shorten the reported path and indent the executed command

	$filter = "| cut -d: -f2- | sed 's/050/    050/g'";
    }

    # else

    else
    {
	# the raw output
    }

    my $vigilia_config = do "$workflow_project_directory/vigilia.config";

    my $project_name = $vigilia_config->{package}->{name};

    my $commands
	= [
	   "cd $workflow_project_directory",
	   "grep $regex report_$project_name/*/*summary.yml $filter",
	   "cat report_$project_name/*/030_expected-minus-seen.diff",
	  ];

    execute_shell_command_array($commands);
}


