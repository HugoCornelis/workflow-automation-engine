sub _documentation_vigilia_build
{
    my $tags = shift;

    my $command_line_tags = $tags ? "--tags " . (join ' ', @$tags) : '';

    my $commands
	= [
	   "bin/vigilia --output-pdf --output-figures --verbose --output-content-line-limit 3000 $command_line_tags",
	  ];

    execute_shell_command_array($commands);
}


