#!/usr/bin/perl -w
#!/usr/bin/perl -w -d:ptkdb

use strict;

my $module_filenames = [ sort @ARGV, ];

use Data::Dumper;

# Run a shell command and abort the whole installation if it fails, so that a
# broken build (for example a missing Python.h when python3-dev is not installed)
# can never masquerade as success and silently leave an older version of the
# module in place.

sub run_or_die
{
    my ($command, $context) = @_;

    print "cpan_install: running: $command\n";

    my $status = system $command;

    if ($status != 0)
    {
	my $detail
	    = $status == -1   ? "failed to execute: $!"
	    : ($status & 127) ? "died with signal " . ($status & 127)
	    :                   "exited with status " . ($status >> 8);

	die "cpan_install: *** ERROR while $context: '$command' $detail\n";
    }
}

# Like run_or_die, but only warns.  Used for the test suite, whose failures
# should be visible without necessarily blocking installation.

sub run_or_warn
{
    my ($command, $context) = @_;

    print "cpan_install: running: $command\n";

    if (system $command)
    {
	warn "cpan_install: *** WARNING while $context: '$command' failed (continuing)\n";
    }
}

print "Installing CPAN modules\n";

print Dumper($module_filenames);

# loop over all required modules

foreach my $module_filename (@$module_filenames)
{
    $module_filename =~ /^...(.*)\.tar\.gz$/i;

    my $module_name = $1;

    # is this module already installed?

    $module_name =~ /([^0-9\.]+)-([0-9\.]+)/;

    my $module_perl = $1;

    my $module_version_to_install = $2;

    $module_perl =~ s/-/::/g;

    print "checking for perl -e 'use $module_perl $module_version_to_install'\n";
    system "perl -e 'use $module_perl $module_version_to_install'";

    my $installed = not $?;

    if ($installed)
    {
	# module is already installed, skip it

	print "Not installing $module_name ($module_filename), it looks like it is already installed\n";

	next;
    }

    print "Installing $module_name ($module_filename)\n";

    print `pwd`;

    # unpack the module

    run_or_die("tar xfz $module_filename --no-same-owner --no-same-permissions", "unpacking $module_name");

    chdir $module_name
	or die "cpan_install: *** ERROR: cannot enter '$module_name' after unpacking: $!\n";

    print `pwd`;

    # run the perl makefile

    # inline python ...

    if ($module_name =~ /inline-python/i)
    {
	# ... uses an interactive perl makefile

	run_or_die("echo '' | perl Makefile.PL", "configuring $module_name");
    }

    # ... other inline modules ...

    elsif ($module_name =~ /inline/i)
    {
	# ... have perl makefiles that ask questions that should be answered with 'y'es.

	run_or_die("echo y | perl Makefile.PL", "configuring $module_name");
    }

    # ... other modules ...

    else
    {
	# ... don't require special handling

	run_or_die("perl Makefile.PL", "configuring $module_name");
    }

    # build and install

    run_or_die("make", "building $module_name");

    run_or_warn("make test", "testing $module_name");

    run_or_die("sudo make install", "installing $module_name");

    chdir ".."
	or die "cpan_install: *** ERROR: cannot return to the cpan directory: $!\n";

    system "rm -fr $module_name";

}


